# SQL Server (same DB for localhost + production)
# Replace YOUR_PASSWORD with the ebm_rw password from your host
DATABASE_URL="sqlserver://161.35.136.204:1433;database=EBM_RW;user=ebm_rw;password=YOUR_PASSWORD;encrypt=true;trustServerCertificate=true"
GQ_JWT_SECRET="dev-jwt-secret-change-me-in-prod-32chars"
GQ_PHONE_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
GQ_HMAC_SECRET="dev-hmac-secret-change-me"
GQ_OTP_PEPPER="dev-otp-pepper"

# Production QR base (never use laptop IP on live stickers)
NEXT_PUBLIC_APP_URL="https://ebm.rw"
GQ_ALLOW_LAN_URL=1
# Optional: pin LAN URL for phone QR testing (ipconfig IPv4, e.g. http://192.168.1.71:3000)
# GQ_DEV_LAN_URL=http://192.168.1.71:3000

# Open OTP for pilot (default ON). Set GQ_STRICT_AUTH=1 to require real SMS OTP.
GQ_OPEN_LOGIN=1
NEXT_PUBLIC_GQ_OPEN_LOGIN=1

# Ihute shop link on MoMo screen (?shop=nickname only — group stays on GQ URL)
NEXT_PUBLIC_IHUTE_SHOP_BASE="https://ihute.rw/shop-with-me"
